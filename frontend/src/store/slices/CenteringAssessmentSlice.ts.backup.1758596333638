// 初始狀態
const initialState: CenteringAssessmentState = {
  assessments: [],
  reports: [],
  history: [],
  filters: {},
  currentAssessment: null,
  isLoading: false,
  isProcessing: false,
  isGeneratingReport: false,
  error: null,
  statistics: null,
};

// 創建 slice
const centeringAssessmentSlice = createSlice({
  name: 'centeringAssessment',
  initialState,
  reducers: {
    setFilters: (state, action: PayloadAction<CenteringFilters>) => {
      state.filters = action.payload;
    },
    clearFilters: state => {
      state.filters = {};
    },
    setCurrentAssessment: (
      state,
      action: PayloadAction<CenteringAssessment | null>
    ) => {
      state.currentAssessment = action.payload;
    },
    clearCurrentAssessment: state => {
      state.currentAssessment = null;
    },
    clearError: state => {
      state.error = null;
    },
    clearAssessments: state => {
      state.assessments = [];
    },
    clearReports: state => {
      state.reports = [];
    },
    updateAssessment: (state, action: PayloadAction<CenteringAssessment>) => {
      const index = state.assessments.findIndex(
        a => a.id === action.payload.id
      );
      if (index !== -1) {
        state.assessments[index] = action.payload;
      } else {
        state.assessments.push(action.payload);
      }
    },
    removeAssessment: (state, action: PayloadAction<string>) => {
      state.assessments = state.assessments.filter(
        a => a.id !== action.payload
      );
    },
  },
  extraReducers: builder => {
    // Initialize Centering Assessment
    builder
      .addCase(initializeCenteringAssessment.pending, state => {
        state.isLoading = true;
        state.error = null;
      })
      .addCase(initializeCenteringAssessment.fulfilled, (state, action) => {
        state.isLoading = false;
        state.statistics = action.payload;
        state.error = null;
      })
      .addCase(initializeCenteringAssessment.rejected, (state, action) => {
        state.isLoading = false;
        state.error = action.payload as string;
      });

    // Start Centering Assessment
    builder
      .addCase(startCenteringAssessment.fulfilled, (state, action) => {
        state.assessments.push(action.payload);
        state.currentAssessment = action.payload;
      })
      .addCase(startCenteringAssessment.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Process Centering Assessment
    builder
      .addCase(processCenteringAssessment.pending, state => {
        state.isProcessing = true;
        state.error = null;
      })
      .addCase(processCenteringAssessment.fulfilled, (state, action) => {
        state.isProcessing = false;
        const index = state.assessments.findIndex(
          a => a.id === action.payload.id
        );
        if (index !== -1) {
          state.assessments[index] = action.payload;
        }
        if (state.currentAssessment?.id === action.payload.id) {
          state.currentAssessment = action.payload;
        }
        state.error = null;
      })
      .addCase(processCenteringAssessment.rejected, (state, action) => {
        state.isProcessing = false;
        state.error = action.payload as string;
      });

    // Generate Centering Report
    builder
      .addCase(generateCenteringReport.pending, state => {
        state.isGeneratingReport = true;
        state.error = null;
      })
      .addCase(generateCenteringReport.fulfilled, (state, action) => {
        state.isGeneratingReport = false;
        state.reports.push(action.payload);
        state.error = null;
      })
      .addCase(generateCenteringReport.rejected, (state, action) => {
        state.isGeneratingReport = false;
        state.error = action.payload as string;
      });

    // Fetch Centering Assessments
    builder
      .addCase(fetchCenteringAssessments.fulfilled, (state, action) => {
        state.assessments = action.payload;
      })
      .addCase(fetchCenteringAssessments.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Fetch Centering History
    builder
      .addCase(fetchCenteringHistory.fulfilled, (state, action) => {
        const existingIndex = state.history.findIndex(
          h => h.cardId === action.payload.cardId
        );
        if (existingIndex !== -1) {
          state.history[existingIndex] = action.payload;
        } else {
          state.history.push(action.payload);
        }
      })
      .addCase(fetchCenteringHistory.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Update Assessment Status
    builder
      .addCase(updateAssessmentStatus.fulfilled, (state, action) => {
        const assessment = state.assessments.find(
          a => a.id === action.payload.assessmentId
        );
        if (assessment) {
          assessment.status = action.payload.status as any;
          assessment.updatedAt = action.payload.updatedAt;
        }
      })
      .addCase(updateAssessmentStatus.rejected, (state, action) => {
        state.error = action.payload as string;
      });
  },
});

// 導出 actions
export const {
  setFilters,
  clearFilters,
  setCurrentAssessment,
  clearCurrentAssessment,
  clearError,
  clearAssessments,
  clearReports,
  updateAssessment,
  removeAssessment,
} = centeringAssessmentSlice.actions;

