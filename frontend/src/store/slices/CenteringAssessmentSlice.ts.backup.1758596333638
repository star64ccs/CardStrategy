import type { PayloadAction } from '@reduxjs/toolkit';
import { createAsyncThunk, createSlice } from '@reduxjs/toolkit';

// 定義置中評估相關類型
export interface CenteringAssessment {
  id: string;
  cardId: string;
  userId: string;
  assessmentType: 'front' | 'back' | 'both';
  status: 'pending' | 'processing' | 'completed' | 'failed';
  result: {
    overallScore: number;
    grade:
      | 'PSA 10'
      | 'PSA 9'
      | 'PSA 8'
      | 'PSA 7'
      | 'PSA 6'
      | 'PSA 5'
      | 'PSA 4'
      | 'PSA 3'
      | 'PSA 2'
      | 'PSA 1';
    details: {
      frontScore?: number;
      backScore?: number;
      leftMargin?: number;
      rightMargin?: number;
      topMargin?: number;
      bottomMargin?: number;
      centerDeviation?: number;
    };
    measurements: {
      cardWidth: number;
      cardHeight: number;
      imageWidth: number;
      imageHeight: number;
      margins: {
        left: number;
        right: number;
        top: number;
        bottom: number;
      };
    };
    factors: string[];
    recommendations: string[];
  };
  images: {
    front: string;
    back?: string;
    overlay?: string;
  };
  metadata: {
    timestamp: string;
    processingTime: number;
    algorithmVersion: string;
    deviceInfo: {
      platform: string;
      os: string;
      camera: string;
      resolution: string;
    };
  };
  createdAt: string;
  updatedAt: string;
}

export interface CenteringReport {
  id: string;
  assessmentId: string;
  summary: {
    overallGrade: string;
    frontGrade?: string;
    backGrade?: string;
    confidence: number;
    recommendations: string[];
  };
  detailedAnalysis: {
    side: 'front' | 'back';
    score: number;
    grade: string;
    measurements: {
      left: number;
      right: number;
      top: number;
      bottom: number;
      centerDeviation: number;
    };
    issues: string[];
    strengths: string[];
  }[];
  visualizations: {
    type: 'overlay' | 'heatmap' | 'measurements';
    imageUrl: string;
    description: string;
  }[];
  createdAt: string;
}

export interface CenteringHistory {
  id: string;
  cardId: string;
  assessments: CenteringAssessment[];
  statistics: {
    totalAssessments: number;
    averageScore: number;
    gradeDistribution: {
      'PSA 10': number;
      'PSA 9': number;
      'PSA 8': number;
      'PSA 7': number;
      'PSA 6': number;
      'PSA 5': number;
      'PSA 4': number;
      'PSA 3': number;
      'PSA 2': number;
      'PSA 1': number;
    };
    lastAssessmentDate: string;
  };
  trends: {
    date: string;
    averageScore: number;
    gradeCount: number;
  }[];
}

export interface CenteringFilters {
  cardId?: string;
  userId?: string;
  status?: string;
  assessmentType?: string;
  grade?: string;
  dateFrom?: string;
  dateTo?: string;
  scoreMin?: number;
  scoreMax?: number;
}

// 置中評估狀態接口
export interface CenteringAssessmentState {
  assessments: CenteringAssessment[];
  reports: CenteringReport[];
  history: CenteringHistory[];
  filters: CenteringFilters;
  currentAssessment: CenteringAssessment | null;
  isLoading: boolean;
  isProcessing: boolean;
  isGeneratingReport: boolean;
  error: string | null;
  statistics: {
    totalAssessments: number;
    averageScore: number;
    topGrade: string;
    processingTime: number;
  } | null;
}

