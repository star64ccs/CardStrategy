}) => state.centeringAssessment.isGeneratingReport;

export const selectCenteringAssessmentError = (state: {
  centeringAssessment: CenteringAssessmentState;
}) => state.centeringAssessment.error;

// 導出 reducer
export default centeringAssessmentSlice.reducer;
