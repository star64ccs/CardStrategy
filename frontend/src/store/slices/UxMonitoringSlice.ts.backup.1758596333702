import type { PayloadAction } from '@reduxjs/toolkit';
import { createAsyncThunk, createSlice } from '@reduxjs/toolkit';

// 定義 UX 監控相關類型
export interface UXEvent {
  id: string;
  type:
    | 'click'
    | 'scroll'
    | 'hover'
    | 'focus'
    | 'blur'
    | 'input'
    | 'navigation'
    | 'error';
  element: string;
  timestamp: string;
  page: string;
  sessionId: string;
  userId?: string;
  metadata: {
    x?: number;
    y?: number;
    duration?: number;
    value?: string;
    error?: string;
    [key: string]: any;
  };
}

export interface PerformanceMetric {
  id: string;
  name: string;
  value: number;
  unit: string;
  timestamp: string;
  page: string;
  sessionId: string;
  category: 'loading' | 'rendering' | 'interaction' | 'memory' | 'network';
}

export interface UserJourney {
  id: string;
  userId: string;
  sessionId: string;
  steps: {
    page: string;
    action: string;
    timestamp: string;
    duration?: number;
  }[];
  startTime: string;
  endTime: string;
  goal: string;
  completed: boolean;
  conversionRate?: number;
}

export interface HeatmapData {
  id: string;
  page: string;
  type: 'click' | 'scroll' | 'move';
  data: {
    x: number;
    y: number;
    intensity: number;
  }[];
  viewport: {
    width: number;
    height: number;
  };
  timestamp: string;
}

export interface UXAlert {
  id: string;
  type: 'performance' | 'error' | 'conversion' | 'engagement';
  severity: 'low' | 'medium' | 'high' | 'critical';
  title: string;
  description: string;
  threshold: number;
  currentValue: number;
  triggeredAt: string;
  resolvedAt?: string;
  status: 'active' | 'resolved' | 'ignored';
}

export interface MonitoringFilters {
  page?: string;
  userId?: string;
  sessionId?: string;
  eventType?: string;
  dateFrom?: string;
  dateTo?: string;
  severity?: string;
}

// UX 監控狀態接口
export interface UXMonitoringState {
  events: UXEvent[];
  performanceMetrics: PerformanceMetric[];
  userJourneys: UserJourney[];
  heatmapData: HeatmapData[];
  alerts: UXAlert[];
  filters: MonitoringFilters;
  isLoading: boolean;
  isRecording: boolean;
  isAnalyzing: boolean;
  error: string | null;
  recordingConfig: {
    enabled: boolean;
    sampleRate: number;
    maxEvents: number;
    retentionDays: number;
  };
  realTimeStats: {
    activeUsers: number;
    pageViews: number;
    bounceRate: number;
    avgSessionDuration: number;
  } | null;
}

// 異步 Action Creators
export const initializeUXMonitoring = createAsyncThunk(
  'uxMonitoring/initializeUXMonitoring',
  async (_, { rejectWithValue }) => {
    try {
      // 模擬初始化 UX 監控
      const config = {
        enabled: true,
        sampleRate: 0.1,
        maxEvents: 1000,
        retentionDays: 30,
      };

      const realTimeStats = {
        activeUsers: 45,
        pageViews: 1250,
        bounceRate: 0.35,
        avgSessionDuration: 180, // seconds
      };

      return { config, realTimeStats };
    } catch (error: any) {
      return rejectWithValue((error as any).message || '初始化 UX 監控失敗');
    }
  }
);

export const startRecording = createAsyncThunk(
  'uxMonitoring/startRecording',
  async (
    config: { sampleRate?: number; maxEvents?: number },
    { rejectWithValue }
  ) => {
    try {
      // 模擬開始錄製
      const recordingConfig = {
        enabled: true,
        sampleRate: config.sampleRate || 0.1,
        maxEvents: config.maxEvents || 1000,
        retentionDays: 30,
      };

      return recordingConfig;
    } catch (error: any) {
      return rejectWithValue((error as any).message || '開始錄製失敗');
    }
  }
);

export const stopRecording = createAsyncThunk(
  'uxMonitoring/stopRecording',
  async (_, { rejectWithValue }) => {
    try {
      // 模擬停止錄製
      return { enabled: false };
    } catch (error: any) {
      return rejectWithValue((error as any).message || '停止錄製失敗');
    }
  }
);

export const recordEvent = createAsyncThunk(
  'uxMonitoring/recordEvent',
  async (
    event: {
      type: string;
      element: string;
      page: string;
      sessionId: string;
      metadata: Record<string, any>;
    },
    { rejectWithValue }
  ) => {
    try {
      // 模擬記錄事件
      const newEvent: UXEvent = {
        id: Date.now().toString(),
        type: event.type as any,
        element: event.element,
        timestamp: new Date().toISOString(),
        page: event.page,
        sessionId: event.sessionId,
        metadata: event.metadata,
      };

      return newEvent;
    } catch (error: any) {
      return rejectWithValue((error as any).message || '記錄事件失敗');
    }
  }
);

