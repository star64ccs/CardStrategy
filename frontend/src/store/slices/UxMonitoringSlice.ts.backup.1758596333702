  'uxMonitoring/resolveAlert',
  async (alertId: string, { rejectWithValue }) => {
    try {
      // 模擬解決提醒
      return { alertId, resolvedAt: new Date().toISOString() };
    } catch (error: any) {
      return rejectWithValue((error as any).message || '解決提醒失敗');
    }
  }
);

export const analyzeUserJourney = createAsyncThunk(
  'uxMonitoring/analyzeUserJourney',
  async (
    config: {
      userId: string;
      sessionId: string;
      goal: string;
    },
    { rejectWithValue }
  ) => {
    try {
      // 模擬分析用戶旅程
      const journey: UserJourney = {
        id: Date.now().toString(),
        userId: config.userId,
        sessionId: config.sessionId,
        steps: [
          {
            page: '/home',
            action: 'visit',
            timestamp: new Date(Date.now() - 300000).toISOString(),
            duration: 30,
          },
          {
            page: '/products',
            action: 'navigate',
            timestamp: new Date(Date.now() - 270000).toISOString(),
            duration: 120,
          },
          {
            page: '/checkout',
            action: 'navigate',
            timestamp: new Date(Date.now() - 150000).toISOString(),
            duration: 180,
          },
        ],
        startTime: new Date(Date.now() - 300000).toISOString(),
        endTime: new Date().toISOString(),
        goal: config.goal,
        completed: true,
        conversionRate: 0.75,
      };

      return journey;
    } catch (error: any) {
      return rejectWithValue((error as any).message || '分析用戶旅程失敗');
    }
  }
);

// 初始狀態
const initialState: UXMonitoringState = {
  events: [],
  performanceMetrics: [],
  userJourneys: [],
  heatmapData: [],
  alerts: [],
  filters: {},
  isLoading: false,
  isRecording: false,
  isAnalyzing: false,
  error: null,
  recordingConfig: {
    enabled: false,
    sampleRate: 0.1,
    maxEvents: 1000,
    retentionDays: 30,
  },
  realTimeStats: null,
};

// 創建 slice
const uxMonitoringSlice = createSlice({
  name: 'uxMonitoring',
  initialState,
  reducers: {
    setFilters: (state, action: PayloadAction<MonitoringFilters>) => {
      state.filters = action.payload;
    },
    clearFilters: state => {
      state.filters = {};
    },
    clearError: state => {
      state.error = null;
    },
    clearEvents: state => {
      state.events = [];
    },
    clearAlerts: state => {
      state.alerts = [];
    },
    updateRecordingConfig: (
      state,
      action: PayloadAction<Partial<typeof state.recordingConfig>>
    ) => {
      state.recordingConfig = { ...state.recordingConfig, ...action.payload };
    },
    addEvent: (state, action: PayloadAction<UXEvent>) => {
      state.events.push(action.payload);
      if (state.events.length > state.recordingConfig.maxEvents) {
        state.events.shift();
      }
    },
    addPerformanceMetric: (state, action: PayloadAction<PerformanceMetric>) => {
      state.performanceMetrics.push(action.payload);
    },
    updateRealTimeStats: (
      state,
      action: PayloadAction<typeof state.realTimeStats>
    ) => {
      state.realTimeStats = action.payload;
    },
  },
  extraReducers: builder => {
    // Initialize UX Monitoring
    builder
      .addCase(initializeUXMonitoring.pending, state => {
        state.isLoading = true;
        state.error = null;
      })
      .addCase(initializeUXMonitoring.fulfilled, (state, action) => {
        state.isLoading = false;
        state.recordingConfig = action.payload.config;
        state.realTimeStats = action.payload.realTimeStats;
        state.error = null;
      })
      .addCase(initializeUXMonitoring.rejected, (state, action) => {
        state.isLoading = false;
        state.error = action.payload as string;
      });

    // Start Recording
    builder
      .addCase(startRecording.fulfilled, (state, action) => {
        state.recordingConfig = action.payload;
        state.isRecording = true;
      })
      .addCase(startRecording.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Stop Recording
    builder
      .addCase(stopRecording.fulfilled, (state, action) => {
        state.recordingConfig.enabled = action.payload.enabled;
        state.isRecording = false;
      })
      .addCase(stopRecording.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Record Event
    builder
      .addCase(recordEvent.fulfilled, (state, action) => {
        state.events.push(action.payload);
        if (state.events.length > state.recordingConfig.maxEvents) {
          state.events.shift();
        }
      })
      .addCase(recordEvent.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Fetch UX Events
    builder
      .addCase(fetchUXEvents.fulfilled, (state, action) => {
        state.events = action.payload;
      })
      .addCase(fetchUXEvents.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Fetch Performance Metrics
    builder
      .addCase(fetchPerformanceMetrics.fulfilled, (state, action) => {
        state.performanceMetrics = action.payload;
      })
      .addCase(fetchPerformanceMetrics.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Generate Heatmap
    builder
      .addCase(generateHeatmap.fulfilled, (state, action) => {
        state.heatmapData.push(action.payload);
      })
      .addCase(generateHeatmap.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Create UX Alert
    builder
      .addCase(createUXAlert.fulfilled, (state, action) => {
        state.alerts.push(action.payload);
      })
      .addCase(createUXAlert.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Resolve Alert
    builder
      .addCase(resolveAlert.fulfilled, (state, action) => {
        const alert = state.alerts.find(a => a.id === action.payload.alertId);
        if (alert) {
          alert.status = 'resolved';
          alert.resolvedAt = action.payload.resolvedAt;
        }
      })
      .addCase(resolveAlert.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Analyze User Journey
    builder
      .addCase(analyzeUserJourney.pending, state => {
        state.isAnalyzing = true;
        state.error = null;
      })
      .addCase(analyzeUserJourney.fulfilled, (state, action) => {
        state.isAnalyzing = false;
        state.userJourneys.push(action.payload);
        state.error = null;
      })
      .addCase(analyzeUserJourney.rejected, (state, action) => {
        state.isAnalyzing = false;
        state.error = action.payload as string;
      });
  },
});

// 導出 actions
export const {
  setFilters,
  clearFilters,
  clearError,
  clearEvents,
  clearAlerts,
  updateRecordingConfig,
  addEvent,
  addPerformanceMetric,
  updateRealTimeStats,
} = uxMonitoringSlice.actions;

