      threshold: number;
    },
    { rejectWithValue }
  ) => {
    try {
      // 模擬創建 UX 提醒
      const newAlert: UXAlert = {
        id: Date.now().toString(),
        type: alert.type as any,
        severity: alert.severity as any,
        title: alert.title,
        description: alert.description,
