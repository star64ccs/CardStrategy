// 初始狀態
const initialState: PriceDataState = {
  prices: [],
  priceHistory: [],
  marketAnalysis: [],
  priceAlerts: [],
  filters: {},
  isLoading: false,
  isUpdating: false,
  isAnalyzing: false,
  error: null,
  pagination: {
    page: 1,
    limit: 20,
    total: 0,
    totalPages: 0,
  },
};

// 創建 slice
const priceDataSlice = createSlice({
  name: 'priceData',
  initialState,
  reducers: {
    setFilters: (state, action: PayloadAction<PriceDataFilters>) => {
      state.filters = action.payload;
    },
    clearFilters: state => {
      state.filters = {};
    },
    clearError: state => {
      state.error = null;
    },
    updatePriceData: (state, action: PayloadAction<PriceData>) => {
      const index = state.prices.findIndex(p => p.id === action.payload.id);
      if (index !== -1) {
        state.prices[index] = action.payload;
      } else {
        state.prices.push(action.payload);
      }
    },
    removePriceData: (state, action: PayloadAction<string>) => {
      state.prices = state.prices.filter(p => p.id !== action.payload);
    },
  },
  extraReducers: builder => {
    // Fetch Price Data
    builder
      .addCase(fetchPriceData.pending, state => {
        state.isLoading = true;
        state.error = null;
      })
      .addCase(fetchPriceData.fulfilled, (state, action) => {
        state.isLoading = false;
        state.prices = action.payload.prices;
        state.pagination = action.payload.pagination;
        state.error = null;
      })
      .addCase(fetchPriceData.rejected, (state, action) => {
        state.isLoading = false;
        state.error = action.payload as string;
      });

    // Fetch Price History
    builder
      .addCase(fetchPriceHistory.fulfilled, (state, action) => {
        const existingIndex = state.priceHistory.findIndex(
          h => h.cardId === action.payload.cardId
        );
        if (existingIndex !== -1) {
          state.priceHistory[existingIndex] = action.payload;
        } else {
          state.priceHistory.push(action.payload);
        }
      })
      .addCase(fetchPriceHistory.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Generate Market Analysis
    builder
      .addCase(generateMarketAnalysis.pending, state => {
        state.isAnalyzing = true;
        state.error = null;
      })
      .addCase(generateMarketAnalysis.fulfilled, (state, action) => {
        state.isAnalyzing = false;
        const existingIndex = state.marketAnalysis.findIndex(
          a => a.cardId === action.payload.cardId
        );
        if (existingIndex !== -1) {
          state.marketAnalysis[existingIndex] = action.payload;
        } else {
          state.marketAnalysis.push(action.payload);
        }
        state.error = null;
      })
      .addCase(generateMarketAnalysis.rejected, (state, action) => {
        state.isAnalyzing = false;
        state.error = action.payload as string;
      });

    // Create Price Alert
    builder
      .addCase(createPriceAlert.fulfilled, (state, action) => {
        state.priceAlerts.push(action.payload);
      })
      .addCase(createPriceAlert.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Update Price Alert
    builder
      .addCase(updatePriceAlert.fulfilled, (state, action) => {
        const index = state.priceAlerts.findIndex(
          a => a.id === action.payload.id
        );
        if (index !== -1) {
          state.priceAlerts[index] = action.payload;
        }
      })
      .addCase(updatePriceAlert.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Delete Price Alert
    builder
      .addCase(deletePriceAlert.fulfilled, (state, action) => {
        state.priceAlerts = state.priceAlerts.filter(
          a => a.id !== action.payload
        );
      })
      .addCase(deletePriceAlert.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Fetch User Price Alerts
    builder
      .addCase(fetchUserPriceAlerts.fulfilled, (state, action) => {
        state.priceAlerts = action.payload;
      })
      .addCase(fetchUserPriceAlerts.rejected, (state, action) => {
        state.error = action.payload as string;
      });
  },
});

// 導出 actions
export const {
  setFilters,
  clearFilters,
  clearError,
  updatePriceData,
  removePriceData,
} = priceDataSlice.actions;

// 導出 selectors
export const selectPriceData = (state: { priceData: PriceDataState }) =>
  state.priceData.prices;

export const selectPriceHistory = (state: { priceData: PriceDataState }) =>
  state.priceData.priceHistory;

export const selectMarketAnalysis = (state: { priceData: PriceDataState }) =>
  state.priceData.marketAnalysis;

export const selectPriceAlerts = (state: { priceData: PriceDataState }) =>
  state.priceData.priceAlerts;

export const selectPriceDataFilters = (state: { priceData: PriceDataState }) =>
  state.priceData.filters;

export const selectPriceDataPagination = (state: {
  priceData: PriceDataState;
}) => state.priceData.pagination;

export const selectIsPriceDataLoading = (state: {
  priceData: PriceDataState;
}) => state.priceData.isLoading;

export const selectIsPriceDataUpdating = (state: {
  priceData: PriceDataState;
}) => state.priceData.isUpdating;

export const selectIsAnalyzing = (state: { priceData: PriceDataState }) =>
  state.priceData.isAnalyzing;

export const selectPriceDataError = (state: { priceData: PriceDataState }) =>
  state.priceData.error;

// 導出 reducer
export default priceDataSlice.reducer;
