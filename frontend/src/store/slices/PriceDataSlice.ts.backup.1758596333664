  async (filters: PriceDataFilters = {}, { rejectWithValue }) => {
    try {
      // 模擬獲取價格數據
      const mockPrices: PriceData[] = [
        {
          id: '1',
          cardId: 'card-1',
          source: 'TCGPlayer',
          price: 25.99,
          currency: 'USD',
          condition: 'Near Mint',
          grade: 'PSA 10',
          timestamp: new Date().toISOString(),
          market: 'US',
          url: 'https://tcgplayer.com/example',
        },
      ];

      return {
        prices: mockPrices,
        pagination: {
          page: 1,
          limit: 20,
          total: mockPrices.length,
          totalPages: 1,
        },
      };
    } catch (error: any) {
      return rejectWithValue((error as any).message || '獲取價格數據失敗');
    }
  }
);

