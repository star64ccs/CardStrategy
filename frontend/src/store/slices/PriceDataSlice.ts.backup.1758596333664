import type { PayloadAction } from '@reduxjs/toolkit';
import { createAsyncThunk, createSlice } from '@reduxjs/toolkit';

// 定義價格數據相關類型
export interface PriceData {
  id: string;
  cardId: string;
  source: string;
  price: number;
  currency: string;
  condition: string;
  grade?: string;
  timestamp: string;
  market: string;
  url?: string;
}

export interface PriceHistory {
  id: string;
  cardId: string;
  prices: {
    timestamp: string;
    price: number;
    source: string;
  }[];
  averagePrice: number;
  priceRange: {
    min: number;
    max: number;
  };
  trend: 'up' | 'down' | 'stable';
}

export interface MarketAnalysis {
  id: string;
  cardId: string;
  marketCap: number;
  volatility: number;
  liquidity: number;
  demandScore: number;
  supplyScore: number;
  pricePrediction: {
    shortTerm: number;
    mediumTerm: number;
    longTerm: number;
  };
  confidence: number;
  updatedAt: string;
}

export interface PriceAlert {
  id: string;
  userId: string;
  cardId: string;
  condition: 'above' | 'below' | 'equals';
  targetPrice: number;
  isActive: boolean;
  triggeredAt?: string;
  createdAt: string;
}

export interface PriceDataFilters {
  cardId?: string;
  source?: string;
  market?: string;
  condition?: string;
  grade?: string;
  dateFrom?: string;
  dateTo?: string;
  minPrice?: number;
  maxPrice?: number;
}

// 價格數據狀態接口
export interface PriceDataState {
  prices: PriceData[];
  priceHistory: PriceHistory[];
  marketAnalysis: MarketAnalysis[];
  priceAlerts: PriceAlert[];
  filters: PriceDataFilters;
  isLoading: boolean;
  isUpdating: boolean;
  isAnalyzing: boolean;
  error: string | null;
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
}

