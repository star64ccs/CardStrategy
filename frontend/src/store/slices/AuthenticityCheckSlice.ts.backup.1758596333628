}) => state.authenticityCheck.currentCheck;

export const selectAuthenticityFilters = (state: {
  authenticityCheck: AuthenticityCheckState;
}) => state.authenticityCheck.filters;

export const selectAuthenticityStatistics = (state: {
  authenticityCheck: AuthenticityCheckState;
}) => state.authenticityCheck.statistics;

export const selectIsAuthenticityCheckLoading = (state: {
