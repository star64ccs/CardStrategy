}) => state.authenticityCheck.isLoading;

export const selectIsProcessing = (state: {
  authenticityCheck: AuthenticityCheckState;
}) => state.authenticityCheck.isProcessing;

export const selectIsGeneratingReport = (state: {
  authenticityCheck: AuthenticityCheckState;
}) => state.authenticityCheck.isGeneratingReport;

export const selectAuthenticityCheckError = (state: {
  authenticityCheck: AuthenticityCheckState;
}) => state.authenticityCheck.error;

// 導出 reducer
export default authenticityCheckSlice.reducer;
