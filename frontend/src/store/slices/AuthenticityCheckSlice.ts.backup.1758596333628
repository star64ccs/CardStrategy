    }
  }
);

// 初始狀態
const initialState: AuthenticityCheckState = {
  checks: [],
  reports: [],
  history: [],
  filters: {},
  currentCheck: null,
  isLoading: false,
  isProcessing: false,
  isGeneratingReport: false,
  error: null,
  statistics: null,
};

// 創建 slice
const authenticityCheckSlice = createSlice({
  name: 'authenticityCheck',
  initialState,
  reducers: {
    setFilters: (state, action: PayloadAction<AuthenticityFilters>) => {
      state.filters = action.payload;
    },
    clearFilters: state => {
      state.filters = {};
    },
    setCurrentCheck: (
      state,
      action: PayloadAction<AuthenticityCheck | null>
    ) => {
      state.currentCheck = action.payload;
    },
    clearCurrentCheck: state => {
      state.currentCheck = null;
    },
    clearError: state => {
      state.error = null;
    },
    clearChecks: state => {
      state.checks = [];
    },
    clearReports: state => {
      state.reports = [];
    },
    updateCheck: (state, action: PayloadAction<AuthenticityCheck>) => {
      const index = state.checks.findIndex(c => c.id === action.payload.id);
      if (index !== -1) {
        state.checks[index] = action.payload;
      } else {
        state.checks.push(action.payload);
      }
    },
    removeCheck: (state, action: PayloadAction<string>) => {
      state.checks = state.checks.filter(c => c.id !== action.payload);
    },
  },
  extraReducers: builder => {
    // Initialize Authenticity Check
    builder
      .addCase(initializeAuthenticityCheck.pending, state => {
        state.isLoading = true;
        state.error = null;
      })
      .addCase(initializeAuthenticityCheck.fulfilled, (state, action) => {
        state.isLoading = false;
        state.statistics = action.payload;
        state.error = null;
      })
      .addCase(initializeAuthenticityCheck.rejected, (state, action) => {
        state.isLoading = false;
        state.error = action.payload as string;
      });

    // Start Authenticity Check
    builder
      .addCase(startAuthenticityCheck.fulfilled, (state, action) => {
        state.checks.push(action.payload);
        state.currentCheck = action.payload;
      })
      .addCase(startAuthenticityCheck.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Process Authenticity Check
    builder
      .addCase(processAuthenticityCheck.pending, state => {
        state.isProcessing = true;
        state.error = null;
      })
      .addCase(processAuthenticityCheck.fulfilled, (state, action) => {
        state.isProcessing = false;
        const index = state.checks.findIndex(c => c.id === action.payload.id);
        if (index !== -1) {
          state.checks[index] = action.payload;
        }
        if (state.currentCheck?.id === action.payload.id) {
          state.currentCheck = action.payload;
        }
        state.error = null;
      })
      .addCase(processAuthenticityCheck.rejected, (state, action) => {
        state.isProcessing = false;
        state.error = action.payload as string;
      });

    // Generate Authenticity Report
    builder
      .addCase(generateAuthenticityReport.pending, state => {
        state.isGeneratingReport = true;
        state.error = null;
      })
      .addCase(generateAuthenticityReport.fulfilled, (state, action) => {
        state.isGeneratingReport = false;
        state.reports.push(action.payload);
        state.error = null;
      })
      .addCase(generateAuthenticityReport.rejected, (state, action) => {
        state.isGeneratingReport = false;
        state.error = action.payload as string;
      });

    // Fetch Authenticity Checks
    builder
      .addCase(fetchAuthenticityChecks.fulfilled, (state, action) => {
        state.checks = action.payload;
      })
      .addCase(fetchAuthenticityChecks.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Fetch Authenticity History
    builder
      .addCase(fetchAuthenticityHistory.fulfilled, (state, action) => {
        const existingIndex = state.history.findIndex(
          h => h.cardId === action.payload.cardId
        );
        if (existingIndex !== -1) {
          state.history[existingIndex] = action.payload;
        } else {
          state.history.push(action.payload);
        }
      })
      .addCase(fetchAuthenticityHistory.rejected, (state, action) => {
        state.error = action.payload as string;
      });

    // Update Check Status
    builder
      .addCase(updateCheckStatus.fulfilled, (state, action) => {
        const check = state.checks.find(c => c.id === action.payload.checkId);
        if (check) {
          check.status = action.payload.status as any;
          check.updatedAt = action.payload.updatedAt;
        }
      })
      .addCase(updateCheckStatus.rejected, (state, action) => {
        state.error = action.payload as string;
      });
  },
});

// 導出 actions
export const {
  setFilters,
  clearFilters,
  setCurrentCheck,
  clearCurrentCheck,
  clearError,
  clearChecks,
  clearReports,
  updateCheck,
  removeCheck,
} = authenticityCheckSlice.actions;

// 導出 selectors
export const selectAuthenticityChecks = (state: {
