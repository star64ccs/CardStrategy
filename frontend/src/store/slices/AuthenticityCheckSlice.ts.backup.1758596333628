import type { PayloadAction } from '@reduxjs/toolkit';
import { createAsyncThunk, createSlice } from '@reduxjs/toolkit';

// 定義真偽檢查相關類型
export interface AuthenticityCheck {
  id: string;
  cardId: string;
  userId: string;
  checkType:
    | 'hologram'
    | 'texture'
    | 'color'
    | 'edge'
    | 'back'
    | 'holo'
    | 'comprehensive';
  status: 'pending' | 'processing' | 'completed' | 'failed';
  result: {
    isAuthentic: boolean;
    confidence: number;
    details: {
      hologramScore?: number;
      textureScore?: number;
      colorScore?: number;
      edgeScore?: number;
      backScore?: number;
      holoScore?: number;
    };
    factors: string[];
    recommendations: string[];
  };
  images: {
    front: string;
    back?: string;
    holo?: string;
    edge?: string;
  };
  metadata: {
    timestamp: string;
    processingTime: number;
    modelVersion: string;
    deviceInfo: {
      platform: string;
      os: string;
      camera: string;
    };
  };
  createdAt: string;
  updatedAt: string;
}

export interface AuthenticityReport {
  id: string;
  checkId: string;
  summary: {
    overallScore: number;
    isAuthentic: boolean;
    confidence: number;
    riskLevel: 'low' | 'medium' | 'high' | 'critical';
  };
  detailedAnalysis: {
    component: string;
    score: number;
    status: 'pass' | 'fail' | 'warning';
    description: string;
    evidence: string[];
  }[];
  recommendations: {
    action: string;
    priority: 'high' | 'medium' | 'low';
    description: string;
  }[];
  expertReview?: {
    reviewedBy: string;
    reviewedAt: string;
    notes: string;
    finalDecision: boolean;
  };
  createdAt: string;
}

export interface AuthenticityHistory {
  id: string;
  cardId: string;
  checks: AuthenticityCheck[];
  statistics: {
    totalChecks: number;
    authenticCount: number;
    fakeCount: number;
    averageConfidence: number;
    lastCheckDate: string;
  };
  trends: {
    date: string;
    authenticRate: number;
    averageConfidence: number;
  }[];
}

export interface AuthenticityFilters {
  cardId?: string;
  userId?: string;
  status?: string;
  checkType?: string;
  isAuthentic?: boolean;
  dateFrom?: string;
  dateTo?: string;
  confidenceMin?: number;
  confidenceMax?: number;
}

// 真偽檢查狀態接口
export interface AuthenticityCheckState {
  checks: AuthenticityCheck[];
  reports: AuthenticityReport[];
  history: AuthenticityHistory[];
  filters: AuthenticityFilters;
  currentCheck: AuthenticityCheck | null;
  isLoading: boolean;
  isProcessing: boolean;
  isGeneratingReport: boolean;
  error: string | null;
  statistics: {
    totalChecks: number;
    authenticRate: number;
    averageConfidence: number;
    processingTime: number;
  } | null;
}

