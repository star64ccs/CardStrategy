import React, { useState, useEffect } from 'react';
/**
 * 手勢識別 Hook
 * 提供豐富的手勢操作支持
 */

import { useCallback, useEffect, useRef, useState } from 'react';
import { Animated } from 'react-native';
import {
  PanGestureHandler,
  PinchGestureHandler,
  RotationGestureHandler,
  State,
} from 'react-native-gesture-handler';

export interface GestureState {
  startX: number;
  startY: number;
  currentX: number;
  currentY: number;
  deltaX: number;
  deltaY: number;
  velocityX: number;
  velocityY: number;
  isActive: boolean;
  isDragging: boolean;
  isPinching: boolean;
  isRotating: boolean;
  scale: number;
  rotation: number;
  timestamp: number;
}

export interface GestureConfig {
  enabled?: boolean;
  minDistance?: number;
  maxDistance?: number;
  minScale?: number;
  maxScale?: number;
  minRotation?: number;
  maxRotation?: number;
  velocityThreshold?: number;
  simultaneousGestures?: boolean;
  shouldCancelWhenOutside?: boolean;
  onGestureStart?: (gesture: GestureState) => void;
  onGestureMove?: (gesture: GestureState) => void;
  onGestureEnd?: (gesture: GestureState) => void;
  onSwipe?: (direction: SwipeDirection, velocity: number) => void;
  onPinch?: (scale: number, velocity: number) => void;
  onRotation?: (rotation: number, velocity: number) => void;
  onTap?: (x: number, y: number) => void;
  onDoubleTap?: (x: number, y: number) => void;
  onLongPress?: (x: number, y: number) => void;
}

export enum SwipeDirection {
  LEFT = 'left',
  RIGHT = 'right',
  UP = 'up',
  DOWN = 'down',
  UP_LEFT = 'up_left',
  UP_RIGHT = 'up_right',
  DOWN_LEFT = 'down_left',
  DOWN_RIGHT = 'down_right',
}

export interface GestureResult {
  gestureState: GestureState;
  panRef: React.RefObject<PanGestureHandler>;
  pinchRef: React.RefObject<PinchGestureHandler>;
  rotationRef: React.RefObject<RotationGestureHandler>;
  animatedValue: Animated.ValueXY;
  animatedScale: Animated.Value;
  animatedRotation: Animated.Value;
  handlePanGesture: (event: any) => void;
  handlePinchGesture: (event: any) => void;
  handleRotationGesture: (event: any) => void;
  resetGesture: () => void;
  setGestureEnabled: (enabled: boolean) => void;
}

export function useGesture(config: GestureConfig = {}): GestureResult {
  const {
    enabled = true,
    minDistance = 10,
    maxDistance = 1000,
    minScale = 0.5,
    maxScale = 3.0,
    minRotation = -180,
    maxRotation = 180,
    velocityThreshold = 0.5,
    simultaneousGestures = true,
    shouldCancelWhenOutside = false,
    onGestureStart,
    onGestureMove,
    onGestureEnd,
    onSwipe,
    onPinch,
    onRotation,
    onTap,
    onDoubleTap,
    onLongPress,
  } = config;

  const [gestureState, setGestureState] = useState<GestureState>({
    startX: 0,
    startY: 0,
    currentX: 0,
    currentY: 0,
    deltaX: 0,
    deltaY: 0,
    velocityX: 0,
    velocityY: 0,
    isActive: false,
    isDragging: false,
    isPinching: false,
    isRotating: false,
    scale: 1,
    rotation: 0,
    timestamp: 0,
  });

  const [gestureEnabled, setGestureEnabledState] = useState(enabled);

  const panRef = useRef<PanGestureHandler>(null);
  const pinchRef = useRef<PinchGestureHandler>(null);
  const rotationRef = useRef<RotationGestureHandler>(null);

  const animatedValue = useRef(new Animated.ValueXY()).current;
  const animatedScale = useRef(new Animated.Value(1)).current;
  const animatedRotation = useRef(new Animated.Value(0)).current;

  const lastTapTime = useRef(0);
  const longPressTimer = useRef<NodeJS.Timeout>();
  const startTime = useRef(0);
  const lastPosition = useRef({ x: 0, y: 0 });
  const lastScale = useRef(1);
  const lastRotation = useRef(0);

  // 檢測滑動手勢方向
  const detectSwipeDirection = useCallback(
    (
      deltaX: number,
      deltaY: number,
      velocityX: number,
      velocityY: number
    ): SwipeDirection | null => {
      const absDeltaX = Math.abs(deltaX);
      const absDeltaY = Math.abs(deltaY);
      const absVelocityX = Math.abs(velocityX);
      const absVelocityY = Math.abs(velocityY);

      // 檢查是否達到最小距離和速度閾值
      if (absDeltaX < minDistance && absDeltaY < minDistance) {
        return null;
      }

      if (
        absVelocityX < velocityThreshold &&
        absVelocityY < velocityThreshold
      ) {
        return null;
      }

      // 確定主要方向
      const isHorizontal = absDeltaX > absDeltaY;
      const isVertical = absDeltaY > absDeltaX;

      if (isHorizontal && absVelocityX > absVelocityY) {
        return deltaX > 0 ? SwipeDirection.RIGHT : SwipeDirection.LEFT;
      }

      if (isVertical && absVelocityY > absVelocityX) {
        return deltaY > 0 ? SwipeDirection.DOWN : SwipeDirection.UP;
      }

      // 對角線滑動
      if (absDeltaX > minDistance && absDeltaY > minDistance) {
        if (deltaX > 0 && deltaY < 0) return SwipeDirection.UP_RIGHT;
        if (deltaX > 0 && deltaY > 0) return SwipeDirection.DOWN_RIGHT;
        if (deltaX < 0 && deltaY < 0) return SwipeDirection.UP_LEFT;
        if (deltaX < 0 && deltaY > 0) return SwipeDirection.DOWN_LEFT;
      }

      return null;
    },
    [minDistance, velocityThreshold]
  );

  // 處理平移手勢
  const handlePanGesture = useCallback(
    (event: any) => {
      if (!gestureEnabled) return;

      const { translationX, translationY, velocityX, velocityY, state } =
        event.nativeEvent;
      const currentTime = Date.now();

      switch (state) {
        case State.BEGAN:
          startTime.current = currentTime;
          lastPosition.current = { x: translationX, y: translationY };

          setGestureState(prev => ({
            ...prev,
            startX: translationX,
            startY: translationY,
            currentX: translationX,
            currentY: translationY,
            deltaX: 0,
            deltaY: 0,
            velocityX: 0,
            velocityY: 0,
            isActive: true,
            isDragging: true,
            timestamp: currentTime,
          }));

          onGestureStart?.(gestureState);
          break;

        case State.ACTIVE:
          const deltaX = translationX - lastPosition.current.x;
          const deltaY = translationY - lastPosition.current.y;

          setGestureState(prev => ({
            ...prev,
            currentX: translationX,
            currentY: translationY,
            deltaX,
            deltaY,
            velocityX,
            velocityY,
            timestamp: currentTime,
          }));

          // 更新動畫值
          animatedValue.setValue({ x: translationX, y: translationY });

          onGestureMove?.(gestureState);
          break;

        case State.END:
        case State.CANCELLED:
          const finalDeltaX = translationX - lastPosition.current.x;
          const finalDeltaY = translationY - lastPosition.current.y;

          setGestureState(prev => ({
            ...prev,
            currentX: translationX,
            currentY: translationY,
            deltaX: finalDeltaX,
            deltaY: finalDeltaY,
            velocityX,
            velocityY,
            isActive: false,
            isDragging: false,
            timestamp: currentTime,
          }));

          // 檢測滑動手勢
          const swipeDirection = detectSwipeDirection(
            finalDeltaX,
            finalDeltaY,
            velocityX,
            velocityY
          );
          if (swipeDirection) {
            const velocity = Math.sqrt(
              velocityX * velocityX + velocityY * velocityY
            );
            onSwipe?.(swipeDirection, velocity);
          }

          // 檢測點擊手勢
          const distance = Math.sqrt(
            finalDeltaX * finalDeltaX + finalDeltaY * finalDeltaY
          );
          const duration = currentTime - startTime.current;

          if (distance < minDistance && duration < 300) {
            // 單擊
            const currentTime = Date.now();
            if (currentTime - lastTapTime.current < 300) {
              // 雙擊
              onDoubleTap?.(translationX, translationY);
            } else {
              // 單擊
              onTap?.(translationX, translationY);
            }
            lastTapTime.current = currentTime;
          }

          onGestureEnd?.(gestureState);
          break;
      }
    },
    [
      gestureEnabled,
      gestureState,
      animatedValue,
      detectSwipeDirection,
      minDistance,
      onGestureStart,
      onGestureMove,
      onGestureEnd,
      onSwipe,
      onTap,
      onDoubleTap,
    ]
  );

  // 處理縮放手勢
  const handlePinchGesture = useCallback(
    (event: any) => {
      if (!gestureEnabled) return;

      const { scale, velocity, state } = event.nativeEvent;
      const currentTime = Date.now();

      switch (state) {
        case State.BEGAN:
          lastScale.current = 1;
          setGestureState(prev => ({
            ...prev,
            isPinching: true,
            scale: 1,
            timestamp: currentTime,
          }));
          break;

        case State.ACTIVE:
          const newScale = Math.max(minScale, Math.min(maxScale, scale));

          setGestureState(prev => ({
            ...prev,
            scale: newScale,
            timestamp: currentTime,
          }));

          // 更新動畫值
          animatedScale.setValue(newScale);
          onPinch?.(newScale, velocity);
          break;

        case State.END:
        case State.CANCELLED:
          setGestureState(prev => ({
            ...prev,
            isPinching: false,
            scale: Math.max(minScale, Math.min(maxScale, scale)),
            timestamp: currentTime,
          }));
          break;
      }
    },
    [gestureEnabled, minScale, maxScale, animatedScale, onPinch]
  );

  // 處理旋轉手勢
  const handleRotationGesture = useCallback(
    (event: any) => {
      if (!gestureEnabled) return;

      const { rotation, velocity, state } = event.nativeEvent;
      const currentTime = Date.now();

      switch (state) {
        case State.BEGAN:
          lastRotation.current = 0;
          setGestureState(prev => ({
            ...prev,
            isRotating: true,
            rotation: 0,
            timestamp: currentTime,
          }));
          break;

        case State.ACTIVE:
          const newRotation = Math.max(
            minRotation,
            Math.min(maxRotation, rotation)
          );

          setGestureState(prev => ({
            ...prev,
            rotation: newRotation,
            timestamp: currentTime,
          }));

          // 更新動畫值
          animatedRotation.setValue(newRotation);
          onRotation?.(newRotation, velocity);
          break;

        case State.END:
        case State.CANCELLED:
          setGestureState(prev => ({
            ...prev,
            isRotating: false,
            rotation: Math.max(minRotation, Math.min(maxRotation, rotation)),
            timestamp: currentTime,
          }));
          break;
      }
    },
    [gestureEnabled, minRotation, maxRotation, animatedRotation, onRotation]
  );

  // 重置手勢狀態
  const resetGesture = useCallback(() => {
    setGestureState({
      startX: 0,
      startY: 0,
      currentX: 0,
      currentY: 0,
      deltaX: 0,
      deltaY: 0,
      velocityX: 0,
      velocityY: 0,
      isActive: false,
      isDragging: false,
      isPinching: false,
      isRotating: false,
      scale: 1,
      rotation: 0,
      timestamp: 0,
    });

    // 重置動畫值
    Animated.parallel([
      Animated.spring(animatedValue, {
        toValue: { x: 0, y: 0 },
        useNativeDriver: true,
      }),
      Animated.spring(animatedScale, {
        toValue: 1,
        useNativeDriver: true,
      }),
      Animated.spring(animatedRotation, {
        toValue: 0,
        useNativeDriver: true,
      }),
    ]).start();
  }, [animatedValue, animatedScale, animatedRotation]);

  // 設置手勢啟用狀態
  const setGestureEnabled = useCallback((enabled: boolean) => {
    setGestureEnabledState(enabled);
  }, []);

  // 長按檢測
  useEffect(() => {
    if (gestureState.isActive && gestureState.isDragging) {
      longPressTimer.current = setTimeout(() => {
        if (gestureState.isActive) {
          onLongPress?.(gestureState.currentX, gestureState.currentY);
        }
      }, 500); // 500ms 長按
    } else {
      if (longPressTimer.current) {
        clearTimeout(longPressTimer.current);
      }
    }

    return () => {
      if (longPressTimer.current) {
        clearTimeout(longPressTimer.current);
      }
    };
  }, [
    gestureState.isActive,
    gestureState.isDragging,
    gestureState.currentX,
    gestureState.currentY,
    onLongPress,
  ]);

  return {
    gestureState,
    panRef,
    pinchRef,
    rotationRef,
    animatedValue,
    animatedScale,
    animatedRotation,
    handlePanGesture,
    handlePinchGesture,
    handleRotationGesture,
    resetGesture,
    setGestureEnabled,
  };
}

export default useGesture;
