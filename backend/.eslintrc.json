{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "no-var": "warn",
    "prefer-const": "warn",
    "no-undef": "error",
    "no-dupe-class-members": "error",
    "no-useless-escape": "error",
    "no-case-declarations": "warn",
    "no-useless-catch": "warn"
  }
}
