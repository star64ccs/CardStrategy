  // 創建市場數據記錄
  async createMarketData(cardId, tcgplayerData, cardmarketData) {
    try {
      const marketData = {
        cardId: cardId,
        source: 'tcgplayer',
        price: null,
        marketPrice: null,
        lowPrice: null,
        highPrice: null,
        midPrice: null,
        directLowPrice: null,
        subTypeName: null,
        foil: false,
        nonFoil: false,
        normal: false,
        reverseHolofoil: false,
        holofoil: false,
        unlimitedHolofoil: false,
        firstEditionHolofoil: false,
        firstEditionNormal: false,
        firstEdition: false,
        isActive: true,
        metadata: JSON.stringify({
          tcgplayer: tcgplayerData,
          cardmarket: cardmarketData,
          collectedAt: new Date().toISOString(),
        }),
      };

      // 處理TCGPlayer價格數據
      if (tcgplayerData && tcgplayerData.prices) {
        const prices = tcgplayerData.prices;

        if (prices.normal) {
          marketData.normal = true;
          marketData.price = prices.normal.mid || prices.normal.low;
          marketData.lowPrice = prices.normal.low;
          marketData.highPrice = prices.normal.high;
          marketData.midPrice = prices.normal.mid;
          marketData.directLowPrice = prices.normal.directLow;
        }

        if (prices.holofoil) {
          marketData.holofoil = true;
          marketData.foil = true;
        }

        if (prices.reverseHolofoil) {
          marketData.reverseHolofoil = true;
        }
      }

      await this.MarketData.create(marketData);
    } catch (error) {
      logger.error('創建市場數據失敗:', error);
    }
  }

  // 延遲函數
  delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // 獲取收集統計
  async getCollectionStats() {
    try {
      await this.initializeModels();

      const stats = await this.Card.findAll({
        attributes: [
          'cardType',
          [
            this.Card.sequelize.fn('COUNT', this.Card.sequelize.col('id')),
            'count',
          ],
        ],
        where: {
          isActive: true,
        },
        group: ['cardType'],
      });

      return {
        success: true,
        stats: stats,
        timestamp: new Date().toISOString(),
      };
    } catch (error) {
      logger.error('獲取收集統計失敗:', error);
      throw error;
    }
  }
