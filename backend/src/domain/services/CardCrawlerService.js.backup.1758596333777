  // 收集寶可夢卡牌數據
  async collectPokemonCards() {
    try {
      logger.info('🔍 開始收集寶可夢卡牌數據...');

      const config = this.apiConfigs.pokemon;
      let allCards = [];
      let page = 1;
      const pageSize = 250; // 每頁最大數量

      // 獲取所有寶可夢卡牌
      while (true) {
        try {
          const response = await axios.get(`${config.baseUrl}/cards`, {
            headers: config.headers,
            params: {
              page: page,
              pageSize: pageSize,
            },
            timeout: 30000,
          });

          if (!response.data.data || response.data.data.length === 0) {
            break; // 沒有更多數據
          }

          const cards = response.data.data;
          logger.info(`📄 第 ${page} 頁: 收集到 ${cards.length} 張寶可夢卡牌`);

          // 處理每張卡牌
          for (const card of cards) {
            const processedCard = await this.processPokemonCard(card);
            if (processedCard) {
              allCards.push(processedCard);
            }
          }

          page++;

          // 限制頁數，避免過度請求
          if (page > 20) {
            logger.warn('⚠️ 達到頁數限制，停止收集');
            break;
          }

          // 添加延遲，避免API限制
          await this.delay(1000);
        } catch (error) {
          logger.error(`❌ 收集第 ${page} 頁寶可夢卡牌失敗:`, error.message);
          break;
        }
      }

      logger.info(`✅ 寶可夢卡牌收集完成: ${allCards.length} 張`);
      return {
        type: 'pokemon',
        count: allCards.length,
        cards: allCards,
        status: 'completed',
      };
    } catch (error) {
      logger.error('❌ 寶可夢卡牌收集失敗:', error);
      return {
        type: 'pokemon',
        count: 0,
        cards: [],
        status: 'failed',
        error: error.message,
      };
    }
  }

  // 處理單張寶可夢卡牌
  async processPokemonCard(card) {
    try {
      // 檢查卡牌是否已存在
      const existingCard = await this.Card.findOne({
        where: {
          externalId: card.id,
          cardType: 'pokemon',
        },
      });

      if (existingCard) {
        logger.debug(`卡牌已存在: ${card.name} (${card.id})`);
        return null;
      }

      // 創建卡牌記錄
      const cardData = {
        name: card.name,
        cardType: 'pokemon',
        externalId: card.id,
        set: card.set?.name || 'Unknown',
        setCode: card.set?.id || 'unknown',
        rarity: card.rarity || 'Common',
        imageUrl: card.images?.large || card.images?.small || '',
        imageUrlHiRes: card.images?.large || '',
        types: card.types ? card.types.join(', ') : '',
        subtype: card.subtypes ? card.subtypes.join(', ') : '',
        hp: card.hp || null,
        attacks: card.attacks ? JSON.stringify(card.attacks) : null,
        weaknesses: card.weaknesses ? JSON.stringify(card.weaknesses) : null,
        resistances: card.resistances ? JSON.stringify(card.resistances) : null,
        retreatCost: card.retreatCost ? JSON.stringify(card.retreatCost) : null,
        convertedRetreatCost: card.convertedRetreatCost || null,
        nationalPokedexNumbers: card.nationalPokedexNumbers
          ? JSON.stringify(card.nationalPokedexNumbers)
          : null,
        tcgplayer: card.tcgplayer ? JSON.stringify(card.tcgplayer) : null,
        cardmarket: card.cardmarket ? JSON.stringify(card.cardmarket) : null,
        legalities: card.legalities ? JSON.stringify(card.legalities) : null,
        regulationMark: card.regulationMark || null,
        evolvesFrom: card.evolvesFrom || null,
        evolvesTo: card.evolvesTo ? JSON.stringify(card.evolvesTo) : null,
        abilities: card.abilities ? JSON.stringify(card.abilities) : null,
        rules: card.rules ? JSON.stringify(card.rules) : null,
        ancientTrait: card.ancientTrait
          ? JSON.stringify(card.ancientTrait)
          : null,
        flavorText: card.flavorText || null,
        description: `${card.name} - ${card.set?.name || 'Unknown Set'} (${card.rarity || 'Common'})`,
        isActive: true,
        source: 'pokemon_tcg_api',
        metadata: JSON.stringify({
          collectedAt: new Date().toISOString(),
          apiVersion: 'v2',
          originalData: card,
        }),
      };

      const savedCard = await this.Card.create(cardData);

      // 如果有價格信息，創建市場數據記錄
      if (card.tcgplayer || card.cardmarket) {
        await this.createMarketData(
          savedCard.id,
          card.tcgplayer,
          card.cardmarket
        );
      }

      return savedCard;
    } catch (error) {
      logger.error(`處理寶可夢卡牌失敗: ${card.name}`, error);
      return null;
    }
  }

  // 收集海賊王卡牌數據
  async collectOnePieceCards() {
    try {
      logger.info('🔍 開始收集海賊王卡牌數據...');

      // 海賊王卡牌主要通過TCGPlayer API獲取
      const config = this.apiConfigs.tcgplayer;
      let allCards = [];

      try {
        // 首先獲取認證token
        const authResponse = await axios.post(`${config.baseUrl}/token`, {
          grant_type: 'client_credentials',
          client_id: config.apiKey,
          client_secret: config.apiKey, // 這裡需要實際的client_secret
        });

        if (!authResponse.data.access_token) {
          throw new Error('無法獲取TCGPlayer認證token');
        }

        const accessToken = authResponse.data.access_token;

        // 獲取海賊王卡牌分類
        const categoriesResponse = await axios.get(
          `${config.baseUrl}/catalog/categories`,
          {
            headers: {
              Authorization: `Bearer ${accessToken}`,
              'Content-Type': 'application/json',
            },
          }
        );

        // 查找海賊王相關分類
        const onePieceCategory = categoriesResponse.data.results?.find(
          cat =>
            cat.name.toLowerCase().includes('one piece') ||
            cat.name.toLowerCase().includes('海賊王')
        );

        if (onePieceCategory) {
          logger.info(
            `找到海賊王分類: ${onePieceCategory.name} (ID: ${onePieceCategory.categoryId})`
          );

          // 獲取該分類下的產品
          const productsResponse = await axios.get(
            `${config.baseUrl}/catalog/products/${onePieceCategory.categoryId}`,
            {
              headers: {
                Authorization: `Bearer ${accessToken}`,
                'Content-Type': 'application/json',
              },
              params: {
                limit: 100,
                offset: 0,
              },
            }
          );

          const products = productsResponse.data.results || [];
          logger.info(`找到 ${products.length} 個海賊王產品`);

          // 處理每個產品
          for (const product of products) {
            const processedCard = await this.processOnePieceCard(
              product,
              accessToken
            );
            if (processedCard) {
              allCards.push(processedCard);
            }

            // 添加延遲
            await this.delay(500);
          }
        } else {
          logger.warn('⚠️ 未找到海賊王分類，使用模擬數據');
          // 創建一些模擬的海賊王卡牌數據
          allCards = await this.createMockOnePieceCards();
        }
      } catch (error) {
        logger.error('❌ TCGPlayer API請求失敗，使用模擬數據:', error.message);
        allCards = await this.createMockOnePieceCards();
      }

      logger.info(`✅ 海賊王卡牌收集完成: ${allCards.length} 張`);
      return {
        type: 'one_piece',
        count: allCards.length,
        cards: allCards,
        status: 'completed',
      };
    } catch (error) {
      logger.error('❌ 海賊王卡牌收集失敗:', error);
      return {
        type: 'one_piece',
        count: 0,
        cards: [],
        status: 'failed',
        error: error.message,
      };
    }
  }

  // 處理單張海賊王卡牌
  async processOnePieceCard(product, accessToken) {
    try {
      // 檢查卡牌是否已存在
      const existingCard = await this.Card.findOne({
        where: {
          externalId: product.productId.toString(),
          cardType: 'one_piece',
        },
      });

      if (existingCard) {
        return null;
      }

      // 獲取產品詳細信息
      const productDetailsResponse = await axios.get(
        `${this.apiConfigs.tcgplayer.baseUrl}/catalog/products/${product.productId}`,
        {
          headers: {
            Authorization: `Bearer ${accessToken}`,
            'Content-Type': 'application/json',
          },
        }
      );

      const productDetails = productDetailsResponse.data.results[0];

      // 獲取價格信息
      const pricingResponse = await axios.get(
        `${this.apiConfigs.tcgplayer.baseUrl}/pricing/product/${product.productId}`,
        {
          headers: {
            Authorization: `Bearer ${accessToken}`,
            'Content-Type': 'application/json',
          },
        }
      );

      const pricing = pricingResponse.data.results || [];

      // 創建卡牌記錄
      const cardData = {
        name: productDetails.name,
        cardType: 'one_piece',
        externalId: productDetails.productId.toString(),
        set: productDetails.group?.name || 'Unknown',
        setCode: productDetails.group?.groupId?.toString() || 'unknown',
        rarity: productDetails.rarity || 'Common',
        imageUrl: productDetails.imageUrl || '',
        imageUrlHiRes: productDetails.imageUrl || '',
        description: `${productDetails.name} - ${productDetails.group?.name || 'Unknown Set'}`,
        isActive: true,
        source: 'tcgplayer_api',
        metadata: JSON.stringify({
          collectedAt: new Date().toISOString(),
          productDetails: productDetails,
          pricing: pricing,
        }),
      };

      const savedCard = await this.Card.create(cardData);

      // 創建市場數據記錄
      if (pricing.length > 0) {
        await this.createMarketData(savedCard.id, pricing);
      }

      return savedCard;
    } catch (error) {
      logger.error(`處理海賊王卡牌失敗: ${product.name}`, error);
      return null;
    }
  }

