    this.pool = new Pool(this.dbConfig);

    // BGS 鑑定標準配置
    this.bgsStandards = this.initializeBGSStandards();

    // 機器學習模型配置
    this.mlModels = {
      centering: null,
      corners: null,
      edges: null,
      surface: null,
      valuePrediction: null,
    };
  }

