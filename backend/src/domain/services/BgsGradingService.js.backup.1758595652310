  // 主要鑑定方法
  async gradeCard(imageData, cardInfo) {
    try {
      console.log('🔍 開始 BGS 模擬鑑定...');

      // 1. 照片質量驗證
      const photoValidation = await this.validatePhotoQuality(imageData);
      if (!photoValidation.isValid) {
        return {
          error: '照片質量不符合要求',
          validation: photoValidation,
          recommendations: await this.getPhotoCaptureGuidelines('bgs_grading'),
        };
      }

      // 2. 圖像分析
      const imageAnalysis = await this.analyzeImage(imageData);

      // 3. 計算子分數
      const subGrades = await this.calculateSubGrades(imageAnalysis);

      // 4. 獲取 BGS 基準數據
      const benchmarks = await this.getBGSBenchmarks(cardInfo);

      // 5. 價值預測
      const valuePrediction = await this.predictValue(
        subGrades,
        benchmarks,
        cardInfo
      );

      // 6. 生成詳細報告
      const gradingReport = await this.generateGradingReport(
        subGrades,
        valuePrediction,
        benchmarks,
        cardInfo
      );

      // 7. 保存鑑定記錄
      await this.saveGradingRecord(gradingReport, cardInfo);

      console.log('✅ BGS 模擬鑑定完成');
      return gradingReport;
    } catch (error) {
      console.error('❌ BGS 鑑定失敗:', error.message);
      throw error;
    }
  }

  // 圖像分析
  async analyzeImage(imageData) {
    // 這裡應該集成實際的計算機視覺算法
    // 目前使用模擬數據，但結構設計為支持真實的 CV 分析

    const analysis = {
      centering: await this.analyzeCentering(imageData),
      corners: await this.analyzeCorners(imageData),
      edges: await this.analyzeEdges(imageData),
      surface: await this.analyzeSurface(imageData),
      metadata: {
        timestamp: new Date().toISOString(),
        algorithm: 'BGS_Simulation_v1.0',
        confidence: 0.85,
      },
    };

    return analysis;
  }

  // 置中分析
  async analyzeCentering(imageData) {
    // 模擬置中分析 - 實際實現應使用計算機視覺
    return {
      horizontalOffset: Math.random() * 10 - 5, // -5% 到 +5%
      verticalOffset: Math.random() * 8 - 4, // -4% 到 +4%
      confidence: 0.85 + Math.random() * 0.15,
      method: 'edge_detection_and_measurement',
    };
  }

  // 邊角分析
  async analyzeCorners(imageData) {
    // 模擬邊角分析
    return {
      topLeft: Math.random() * 2,
      topRight: Math.random() * 2,
      bottomLeft: Math.random() * 2,
      bottomRight: Math.random() * 2,
      confidence: 0.8 + Math.random() * 0.2,
      method: 'corner_detection_and_damage_assessment',
    };
  }

  // 邊緣分析
  async analyzeEdges(imageData) {
    // 模擬邊緣分析
    return {
      topEdge: Math.random() * 1.5,
      bottomEdge: Math.random() * 1.5,
      leftEdge: Math.random() * 1.5,
      rightEdge: Math.random() * 1.5,
      confidence: 0.75 + Math.random() * 0.25,
      method: 'edge_scanning_and_wear_detection',
    };
  }

  // 表面分析
  async analyzeSurface(imageData) {
    // 模擬表面分析
    return {
      scratches: Math.random() * 3,
      stains: Math.random() * 2,
      creases: Math.random() * 1,
      confidence: 0.7 + Math.random() * 0.3,
      method: 'surface_texture_analysis',
    };
  }

  // 計算子分數
  async calculateSubGrades(imageAnalysis) {
    const subGrades = {};

    // 置中分數
    subGrades.centering = this.calculateGradeFromAnalysis(
      imageAnalysis.centering,
      this.bgsStandards.centering
    );

    // 邊角分數
    subGrades.corners = this.calculateGradeFromAnalysis(
      imageAnalysis.corners,
      this.bgsStandards.corners
    );

    // 邊緣分數
    subGrades.edges = this.calculateGradeFromAnalysis(
      imageAnalysis.edges,
      this.bgsStandards.edges
    );

    // 表面分數
    subGrades.surface = this.calculateGradeFromAnalysis(
      imageAnalysis.surface,
      this.bgsStandards.surface
    );

    // 計算總分
    subGrades.totalGrade = this.calculateTotalGrade(subGrades);

    // 確定標籤類型
    subGrades.labelType = this.determineLabelType(subGrades);

    // 計算置信度
    subGrades.confidence = this.calculateOverallConfidence(imageAnalysis);

    return subGrades;
  }

  // 根據分析結果計算分數
  calculateGradeFromAnalysis(analysisData, standards) {
    let damageScore = 0;

    if (analysisData.horizontalOffset !== undefined) {
      // 置中分析
      const totalOffset = Math.sqrt(
        analysisData.horizontalOffset ** 2 + analysisData.verticalOffset ** 2
      );
      damageScore = totalOffset;
    } else if (analysisData.topLeft !== undefined) {
      // 邊角分析
      damageScore =
        (analysisData.topLeft +
          analysisData.topRight +
          analysisData.bottomLeft +
          analysisData.bottomRight) /
        4;
    } else if (analysisData.topEdge !== undefined) {
      // 邊緣分析
      damageScore =
        (analysisData.topEdge +
          analysisData.bottomEdge +
          analysisData.leftEdge +
          analysisData.rightEdge) /
        4;
    } else if (analysisData.scratches !== undefined) {
      // 表面分析
      damageScore =
        analysisData.scratches + analysisData.stains + analysisData.creases;
    }

    // 根據標準確定分數
    for (const [grade, criteria] of Object.entries(standards.criteria)) {
      if (
        damageScore <= criteria.maxOffset ||
        damageScore <= criteria.maxDamage
      ) {
        return {
          grade: parseFloat(grade),
          description: criteria.description,
          damageScore: damageScore,
          confidence: analysisData.confidence,
        };
      }
    }

    return {
      grade: 6.0,
      description: '嚴重損壞',
      damageScore: damageScore,
      confidence: analysisData.confidence,
    };
  }

  // 計算總分
  calculateTotalGrade(subGrades) {
    const weights = {
      centering: 0.25,
      corners: 0.25,
      edges: 0.25,
      surface: 0.25,
    };
    let totalScore = 0;

    Object.entries(subGrades).forEach(([category, data]) => {
      if (weights[category] && data.grade) {
        totalScore += data.grade * weights[category];
      }
    });

    return Math.round(totalScore * 2) / 2; // 四捨五入到 0.5
  }

  // 確定標籤類型
  determineLabelType(subGrades) {
    const scores = [
      subGrades.centering.grade,
      subGrades.corners.grade,
      subGrades.edges.grade,
      subGrades.surface.grade,
    ];

    if (scores.every(score => score === 10)) {
      return {
        type: 'Black Label',
        chinese: '黑標',
        description: 'BGS 最高等級，極其稀有',
        valueMultiplier: 3.0,
      };
    } else if (scores.every(score => score >= 9.5)) {
      return {
        type: 'Gold Label',
        chinese: '金標',
        description: 'BGS 高級等級，非常稀有',
        valueMultiplier: 2.0,
      };
    } else {
      return {
        type: 'Standard Label',
        chinese: '標準標',
        description: 'BGS 標準等級',
        valueMultiplier: 1.0,
      };
    }
  }

  // 計算整體置信度
  calculateOverallConfidence(imageAnalysis) {
    const confidences = [
      imageAnalysis.centering.confidence,
      imageAnalysis.corners.confidence,
      imageAnalysis.edges.confidence,
      imageAnalysis.surface.confidence,
    ];

    return (
      confidences.reduce((sum, conf) => sum + conf, 0) / confidences.length
    );
  }

  // 獲取 BGS 基準數據
  async getBGSBenchmarks(cardInfo) {
    const client = await this.pool.connect();

    try {
      // 獲取同類卡牌的 BGS 數據
      const result = await client.query(
        `
        SELECT 
          AVG(grade) as avg_grade,
          AVG(value) as avg_value,
          AVG(population) as avg_population,
          MIN(value) as min_value,
          MAX(value) as max_value,
          COUNT(*) as total_records,
          PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY value) as median_value
        FROM grading_data g
        JOIN cards c ON g.card_id = c.id
        WHERE g.grading_company = 'BGS'
        AND c.category = $1
        AND c.rarity = $2
        AND g.is_active = true
      `,
        [cardInfo.category, cardInfo.rarity]
      );

      return result.rows[0];
    } finally {
      client.release();
    }
  }

  // 價值預測
  async predictValue(subGrades, benchmarks, cardInfo) {
    const { totalGrade, labelType } = subGrades;
    const { avg_value, median_value, avg_population } = benchmarks;

    // 基礎價值（使用中位數更穩定）
    let predictedValue = median_value || avg_value || 100;

    // 分數調整
    const gradeMultiplier = totalGrade / 9.5; // 以 9.5 為基準
    predictedValue *= gradeMultiplier;

    // 標籤類型調整
    predictedValue *= labelType.valueMultiplier;

    // 人口調整（人口越少價值越高）
    const populationFactor = Math.max(0.5, 2 - avg_population / 100);
    predictedValue *= populationFactor;

    // 稀有度調整
    const rarityMultiplier = this.getRarityMultiplier(cardInfo.rarity);
    predictedValue *= rarityMultiplier;

    return {
      predictedValue: Math.round(predictedValue),
      confidence: 0.75 + Math.random() * 0.25,
      factors: {
        baseValue: median_value || avg_value,
        gradeMultiplier,
        labelMultiplier: labelType.valueMultiplier,
        populationFactor,
        rarityMultiplier,
      },
      comparison: {
        min: benchmarks.min_value,
        max: benchmarks.max_value,
        avg: benchmarks.avg_value,
        median: median_value,
      },
    };
  }

  // 獲取稀有度倍數
  getRarityMultiplier(rarity) {
    const multipliers = {
      Common: 0.5,
      Uncommon: 0.7,
      Rare: 1.0,
      'Ultra Rare': 1.5,
      'Secret Rare': 2.0,
      Holographic: 1.2,
      'Reverse Holo': 1.1,
    };

    return multipliers[rarity] || 1.0;
  }

  // 生成鑑定報告
  async generateGradingReport(
    subGrades,
    valuePrediction,
    benchmarks,
    cardInfo
  ) {
    const report = {
      cardInfo,
      grading: {
        company: 'BGS',
        subGrades: {
          centering: subGrades.centering,
          corners: subGrades.corners,
          edges: subGrades.edges,
          surface: subGrades.surface,
        },
        totalGrade: subGrades.totalGrade,
        labelType: subGrades.labelType,
        confidence: subGrades.confidence,
      },
      valuePrediction,
      benchmarks,
      recommendations: await this.generateRecommendations(
        subGrades,
        valuePrediction
      ),
      riskAssessment: await this.assessRisk(subGrades, valuePrediction),
      metadata: {
        timestamp: new Date().toISOString(),
        version: '1.0',
        algorithm: 'BGS_Simulation_Service',
      },
    };

    return report;
  }

  // 生成建議
  async generateRecommendations(subGrades, valuePrediction) {
    const recommendations = [];

    // BGS 建議
    if (subGrades.totalGrade >= 9.5) {
      recommendations.push({
        company: 'BGS',
        priority: 'high',
        reason: '高品質卡牌，BGS 子分數系統能更好展示優勢',
        expectedGrade: subGrades.totalGrade,
        expectedValue: valuePrediction.predictedValue,
        confidence: subGrades.confidence,
        estimatedCost: 25,
        turnaroundTime: '2-3 週',
        roi: this.calculateROI(valuePrediction.predictedValue, 25),
      });
    }

    // PSA 建議
    if (subGrades.totalGrade >= 9) {
      recommendations.push({
        company: 'PSA',
        priority: 'medium',
        reason: 'PSA 在市場認可度更高，適合投資',
        expectedGrade: Math.round(subGrades.totalGrade),
        expectedValue: Math.round(valuePrediction.predictedValue * 0.9),
        confidence: subGrades.confidence * 0.9,
        estimatedCost: 20,
        turnaroundTime: '4-6 週',
        roi: this.calculateROI(valuePrediction.predictedValue * 0.9, 20),
      });
    }

    // CGC 建議
    if (subGrades.totalGrade >= 8) {
      recommendations.push({
        company: 'CGC',
        priority: 'low',
        reason: '經濟實惠的選擇，適合預算有限的情況',
        expectedGrade: Math.round(subGrades.totalGrade * 0.95),
        expectedValue: Math.round(valuePrediction.predictedValue * 0.7),
        confidence: subGrades.confidence * 0.8,
        estimatedCost: 15,
        turnaroundTime: '1-2 週',
        roi: this.calculateROI(valuePrediction.predictedValue * 0.7, 15),
      });
    }

    return recommendations.sort((a, b) => b.roi - a.roi);
  }

  // 計算投資回報率
  calculateROI(expectedValue, cost) {
    return ((expectedValue - cost) / cost) * 100;
  }

  // 風險評估
  async assessRisk(subGrades, valuePrediction) {
    const risks = [];
    let overallRisk = 'low';
    let riskScore = 0;

    // 分數風險
    if (subGrades.totalGrade < 8) {
      risks.push('分數較低，可能影響投資價值');
      riskScore += 3;
    } else if (subGrades.totalGrade < 9) {
      risks.push('分數中等，投資價值有限');
      riskScore += 2;
    }

    // 置信度風險
    if (subGrades.confidence < 0.7) {
      risks.push('分析置信度較低，建議人工複檢');
      riskScore += 2;
    }

    // 價值風險
    if (valuePrediction.predictedValue < 100) {
      risks.push('預期價值較低，鑑定成本可能超過收益');
      riskScore += 2;
    }

    // 標籤風險
    if (subGrades.labelType.type === 'Standard Label') {
      risks.push('標準標籤，市場溢價有限');
      riskScore += 1;
    }

    // 確定整體風險等級
    if (riskScore >= 5) {
      overallRisk = 'high';
    } else if (riskScore >= 3) {
      overallRisk = 'medium';
    }

    return {
      overallRisk,
      riskScore,
      risks: risks.length > 0 ? risks : ['風險較低，適合鑑定'],
      recommendation: this.getRiskRecommendation(overallRisk),
      factors: {
        gradeRisk:
          subGrades.totalGrade < 8
            ? 'high'
            : subGrades.totalGrade < 9
              ? 'medium'
              : 'low',
        confidenceRisk: subGrades.confidence < 0.7 ? 'high' : 'low',
        valueRisk: valuePrediction.predictedValue < 100 ? 'high' : 'low',
      },
    };
  }

  // 獲取風險建議
  getRiskRecommendation(riskLevel) {
    switch (riskLevel) {
      case 'low':
        return '建議進行鑑定，投資風險較低';
      case 'medium':
        return '建議謹慎考慮，可等待更好的時機';
      case 'high':
        return '不建議鑑定，投資風險較高';
      default:
        return '需要更多信息進行評估';
    }
  }

  // 保存鑑定記錄
  async saveGradingRecord(report, cardInfo) {
    const client = await this.pool.connect();

    try {
      await client.query(
        `
        INSERT INTO grading_data (
          card_id, grading_company, grade, population, value, 
          source, metadata, is_active
        ) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
        ON CONFLICT (card_id, grading_company) 
        DO UPDATE SET
          grade = EXCLUDED.grade,
          value = EXCLUDED.value,
          metadata = EXCLUDED.metadata,
          updated_at = CURRENT_TIMESTAMP
      `,
        [
          cardInfo.id,
          'BGS',
          report.grading.totalGrade,
          Math.round(report.benchmarks.avg_population || 0),
          report.valuePrediction.predictedValue,
          'simulation_service',
          JSON.stringify(report),
          true,
        ]
      );

      console.log('💾 鑑定記錄已保存');
    } finally {
      client.release();
    }
  }

  // 獲取鑑定歷史
  async getGradingHistory(cardId) {
    const client = await this.pool.connect();

    try {
      const result = await client.query(
        `
        SELECT * FROM grading_data 
        WHERE card_id = $1 AND is_active = true
        ORDER BY created_at DESC
      `,
        [cardId]
      );

      return result.rows;
    } finally {
      client.release();
    }
  }

  // 照片質量驗證
  async validatePhotoQuality(imageData) {
    const validation = {
      isValid: true,
      issues: [],
      quality: {
        resolution: 'unknown',
        lighting: 'unknown',
        focus: 'unknown',
        angle: 'unknown',
        coverage: 'unknown',
      },
      score: 0,
    };

    try {
      // 模擬照片質量檢查
      // 實際實現應該使用計算機視覺算法

      // 檢查解析度
      if (imageData.width && imageData.height) {
        const megapixels = (imageData.width * imageData.height) / 1000000;
        if (megapixels >= 8) {
          validation.quality.resolution = 'excellent';
          validation.score += 20;
        } else if (megapixels >= 4) {
          validation.quality.resolution = 'good';
          validation.score += 15;
        } else if (megapixels >= 2) {
          validation.quality.resolution = 'acceptable';
          validation.score += 10;
        } else {
          validation.quality.resolution = 'poor';
          validation.issues.push('解析度過低，建議使用至少 2MP 的相機');
        }
      }

      // 檢查光照條件
      const lightingScore = Math.random() * 100;
      if (lightingScore >= 80) {
        validation.quality.lighting = 'excellent';
        validation.score += 20;
      } else if (lightingScore >= 60) {
        validation.quality.lighting = 'good';
        validation.score += 15;
      } else if (lightingScore >= 40) {
        validation.quality.lighting = 'acceptable';
        validation.score += 10;
      } else {
        validation.quality.lighting = 'poor';
        validation.issues.push('光照不足或過強，建議在自然光下拍攝');
      }

      // 檢查對焦
      const focusScore = Math.random() * 100;
      if (focusScore >= 85) {
        validation.quality.focus = 'excellent';
        validation.score += 20;
      } else if (focusScore >= 70) {
        validation.quality.focus = 'good';
        validation.score += 15;
      } else if (focusScore >= 50) {
        validation.quality.focus = 'acceptable';
        validation.score += 10;
      } else {
        validation.quality.focus = 'poor';
        validation.issues.push('照片模糊，請確保對焦清晰');
      }

      // 檢查拍攝角度
      const angleScore = Math.random() * 100;
      if (angleScore >= 90) {
        validation.quality.angle = 'excellent';
        validation.score += 20;
      } else if (angleScore >= 75) {
        validation.quality.angle = 'good';
        validation.score += 15;
      } else if (angleScore >= 60) {
        validation.quality.angle = 'acceptable';
        validation.score += 10;
      } else {
        validation.quality.angle = 'poor';
        validation.issues.push('拍攝角度不當，請保持卡片水平');
      }

      // 檢查覆蓋範圍
      const coverageScore = Math.random() * 100;
      if (coverageScore >= 85) {
        validation.quality.coverage = 'excellent';
        validation.score += 20;
      } else if (coverageScore >= 70) {
        validation.quality.coverage = 'good';
        validation.score += 15;
      } else if (coverageScore >= 50) {
        validation.quality.coverage = 'acceptable';
        validation.score += 10;
      } else {
        validation.quality.coverage = 'poor';
        validation.issues.push('卡片未完全包含在照片中');
      }

      // 判斷是否合格
      validation.isValid =
        validation.score >= 60 && validation.issues.length <= 2;

      return validation;
    } catch (error) {
      console.error('照片質量驗證失敗:', error);
      return {
        isValid: false,
        issues: ['照片質量驗證失敗'],
        quality: validation.quality,
        score: 0,
      };
    }
  }

