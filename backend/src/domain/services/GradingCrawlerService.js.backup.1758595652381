        },
        timeout: 30000,
      });

      const $ = cheerio.load(response.data);

      // 解析CGC人口數據
      const populationData = this.parseCGCPopulationReport($, card);

      if (populationData) {
        const savedData = await this.GradingData.create({
          cardId: card.id,
          gradingCompany: 'CGC',
          grade: populationData.grade,
          population: populationData.population,
          value: populationData.value,
          lastUpdated: new Date().toISOString(),
          source: 'cgc_website',
          metadata: JSON.stringify({
            url: searchUrl,
            searchParams: searchParams,
            scrapedAt: new Date().toISOString(),
            rawData: populationData,
          }),
          isActive: true,
        });

        return savedData;
      }

      return null;
    } catch (error) {
      logger.error(`CGC爬取失敗 - ${card.name}:`, error.message);
      return null;
    }
  }

  // 解析CGC人口報告
  parseCGCPopulationReport($, card) {
    try {
      // 查找人口報告表格
      const populationTable = $('.population-report table');
      if (populationTable.length === 0) {
        return null;
      }

      const rows = populationTable.find('tr');
      let bestGrade = null;
      let maxPopulation = 0;

      rows.each((index, row) => {
        if (index === 0) return; // 跳過表頭

        const cells = $(row).find('td');
        if (cells.length >= 3) {
          const grade = $(cells[0]).text().trim();
          const population = parseInt($(cells[1]).text().trim()) || 0;
          const value =
            parseFloat($(cells[2]).text().replace('$', '').replace(',', '')) ||
            0;

          if (population > maxPopulation) {
            maxPopulation = population;
            bestGrade = {
              grade: grade,
              population: population,
              value: value,
            };
          }
        }
      });

      return bestGrade;
    } catch (error) {
      logger.error('解析CGC人口報告失敗:', error);
      return null;
    }
  }

  // 從套裝名稱提取年份
  extractYearFromSet(setName) {
    if (!setName) return null;

    // 嘗試從套裝名稱中提取年份
    const yearMatch = setName.match(/(\d{4})/);
    if (yearMatch) {
      return yearMatch[1];
    }

    // 如果沒有找到年份，返回null
    return null;
  }

  // 延遲函數
  delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  // 獲取鑑定統計
  async getGradingStats() {
    try {
      await this.initializeModels();

      const stats = await this.GradingData.findAll({
        attributes: [
          'gradingCompany',
          [
            this.GradingData.sequelize.fn(
              'COUNT',
              this.GradingData.sequelize.col('id')
            ),
            'count',
          ],
          [
            this.GradingData.sequelize.fn(
              'AVG',
              this.GradingData.sequelize.col('grade')
            ),
            'avgGrade',
          ],
          [
            this.GradingData.sequelize.fn(
              'AVG',
              this.GradingData.sequelize.col('value')
            ),
            'avgValue',
          ],
        ],
        where: {
          isActive: true,
        },
        group: ['gradingCompany'],
      });

      return {
        success: true,
        stats: stats,
        timestamp: new Date().toISOString(),
      };
    } catch (error) {
      logger.error('獲取鑑定統計失敗:', error);
      throw error;
    }
  }
}

module.exports = new GradingCrawlerService();
