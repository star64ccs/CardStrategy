        }
      }

      logger.info(`✅ CGC鑑定數據收集完成: ${allGradingData.length} 條`);
      return {
        type: 'cgc',
        count: allGradingData.length,
        data: allGradingData,
        status: 'completed',
      };
    } catch (error) {
      logger.error('❌ CGC鑑定數據收集失敗:', error);
      return {
        type: 'cgc',
        count: 0,
        data: [],
        status: 'failed',
        error: error.message,
      };
    }
  }

  // 爬取單張卡牌的CGC數據
  async scrapeCGCCard(card, config) {
    try {
      // 構建CGC搜索URL
      const searchUrl = `${config.baseUrl}/population/`;
