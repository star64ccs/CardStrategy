// 白名單功能 - 允許某些IP或用戶不受限制
const createWhitelistLimiter = (baseLimiter, whitelist = []) => {
  return (req, res, next) => {
    const clientIP = req.ip || req.connection.remoteAddress;

    // 檢查是否在白名單中
    if (whitelist.includes(clientIP)) {
      return next(); // 跳過速率限制
    }

    // 檢查是否是本地請求
    if (
      clientIP === '127.0.0.1' ||
      clientIP === '::1' ||
      clientIP === '::ffff:127.0.0.1'
    ) {
      return next(); // 本地請求跳過限制
    }

    // 應用正常的速率限制
    return baseLimiter(req, res, next);
  };
};

module.exports = {
  permissiveLimiter,
  moderateLimiter,
  aiLimiter,
  healthCheckLimiter,
  dataCollectionLimiter,
  createWhitelistLimiter,
};
