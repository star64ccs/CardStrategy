// BGS 模擬鑑定拍攝指引組件
import { Ionicons } from '@expo/vector-icons';
import { Camera } from 'expo-camera';
import React, { useRef, useState } from 'react';
import {
  Alert,
  Dimensions,
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from 'react-native';

const { width, height } = Dimensions.get('window');

interface BGSPhotoCaptureGuideProps {
  onPhotosCaptured: (photos: BGSPhotoSet) => void;
  onCancel: () => void;
}

interface BGSPhotoSet {
  front: string; // 正面照片
  back: string; // 背面照片
  centering: string; // 置中評估照片
  corners: string[]; // 四個角的特寫照片
  edges: string[]; // 四邊的特寫照片
  surface: string; // 表面細節照片
  metadata: {
    timestamp: string;
    quality: 'good' | 'fair' | 'poor';
    notes: string[];
  };
}

export const BGSPhotoCaptureGuide: React.FC<BGSPhotoCaptureGuideProps> = ({
  onPhotosCaptured,
  onCancel,
}) => {
  const [currentStep, setCurrentStep] = useState(0);
  const [capturedPhotos, setCapturedPhotos] = useState<Partial<BGSPhotoSet>>(
    {}
  );
  const [cameraPermission, setCameraPermission] = useState<boolean | null>(
    null
  );
  const cameraRef = useRef<Camera>(null);

  const captureSteps = [
    {
      id: 'front',
      title: '正面照片',
      description: '卡片正面完整照片',
      instructions: [
        '將卡片平放在白色背景上',
        '確保光線充足且均勻',
        '卡片完全在取景框內',
        '避免陰影和反光',
        '保持相機垂直於卡片',
      ],
      icon: 'card',
      required: true,
    },
    {
      id: 'back',
      title: '背面照片',
      description: '卡片背面完整照片',
      instructions: [
        '翻轉卡片拍攝背面',
        '保持相同的拍攝條件',
        '確保背面文字清晰可見',
        '避免指紋和污漬',
        '保持相同的角度和距離',
      ],
      icon: 'card',
      required: true,
    },
    {
      id: 'centering',
      title: '置中評估照片',
      description: '用於評估卡片置中情況',
      instructions: [
        '將卡片放在有網格的背景上',
        '確保卡片邊緣清晰可見',
        '使用尺子或網格輔助對齊',
        '拍攝角度要完全垂直',
        '光線要均勻，避免陰影',
      ],
      icon: 'grid',
      required: true,
    },
    {
      id: 'corners',
      title: '邊角特寫',
      description: '四個角的詳細照片',
      instructions: [
        '拍攝左上角特寫',
        '拍攝右上角特寫',
        '拍攝左下角特寫',
        '拍攝右下角特寫',
        '每張照片要清晰顯示角部狀況',
        '使用微距模式或近距離拍攝',
      ],
      icon: 'square',
      required: true,
      multiple: 4,
    },
    {
      id: 'edges',
      title: '邊緣特寫',
      description: '四邊的詳細照片',
      instructions: [
        '拍攝上邊緣特寫',
        '拍攝下邊緣特寫',
        '拍攝左邊緣特寫',
        '拍攝右邊緣特寫',
        '每張照片要清晰顯示邊緣狀況',
        '注意邊緣的磨損和瑕疵',
      ],
      icon: 'resize',
      required: true,
      multiple: 4,
    },
    {
      id: 'surface',
      title: '表面細節',
      description: '表面瑕疵和狀況照片',
      instructions: [
        '使用側光拍攝表面',
        '突出顯示刮痕和瑕疵',
        '拍攝不同角度的表面',
        '注意反光和污漬',
        '確保表面紋理清晰可見',
      ],
      icon: 'eye',
      required: true,
    },
  ];

  const requestCameraPermission = async () => {
    const { status } = await Camera.requestCameraPermissionsAsync();
    setCameraPermission(status === 'granted');
  };

  const capturePhoto = async () => {
    if (!cameraRef.current) return;

    try {
      const photo = await cameraRef.current.takePictureAsync({
        quality: 0.8,
        base64: false,
        exif: true,
      });

      const currentStepData = captureSteps[currentStep];
      const photoKey = currentStepData.id as keyof BGSPhotoSet;

      if (currentStepData.multiple) {
        // 多張照片的情況
        const existingPhotos = (capturedPhotos[photoKey] as string[]) || [];
        const updatedPhotos = [...existingPhotos, photo.uri];

        setCapturedPhotos(prev => ({
          ...prev,
          [photoKey]: updatedPhotos,
        }));

        if (updatedPhotos.length < currentStepData.multiple) {
          Alert.alert(
            '繼續拍攝',
            `還需要拍攝 ${currentStepData.multiple - updatedPhotos.length} 張照片`,
            [{ text: '繼續', onPress: () => {} }]
          );
          return;
        }
      } else {
        // 單張照片的情況
        setCapturedPhotos(prev => ({
          ...prev,
          [photoKey]: photo.uri,
        }));
      }

      // 檢查是否完成所有必要步驟
      if (currentStep < captureSteps.length - 1) {
        setCurrentStep(currentStep + 1);
      } else {
        // 完成所有拍攝
        const completePhotoSet: BGSPhotoSet = {
          front: capturedPhotos.front || '',
          back: capturedPhotos.back || '',
          centering: capturedPhotos.centering || '',
          corners: (capturedPhotos.corners as string[]) || [],
          edges: (capturedPhotos.edges as string[]) || [],
          surface: capturedPhotos.surface || '',
          metadata: {
            timestamp: new Date().toISOString(),
            quality: 'good',
            notes: [],
          },
        };
        onPhotosCaptured(completePhotoSet);
      }
    } catch (error) {
      Alert.alert('拍攝失敗', '請重試拍攝');
    }
  };

  const renderCameraView = () => (
    <View style={styles.cameraContainer}>
      <Camera
        ref={cameraRef}
        style={styles.camera}
        type={Camera.Constants.Type.back}
        flashMode={Camera.Constants.FlashMode.off}
      >
        <View style={styles.cameraOverlay}>
          <View style={styles.guideFrame}>
            <View style={styles.cornerMarkers}>
              <View style={[styles.cornerMarker, styles.topLeft]} />
              <View style={[styles.cornerMarker, styles.topRight]} />
              <View style={[styles.cornerMarker, styles.bottomLeft]} />
              <View style={[styles.cornerMarker, styles.bottomRight]} />
            </View>
          </View>
          <Text style={styles.overlayText}>
            {captureSteps[currentStep].instructions[0]}
          </Text>
        </View>
      </Camera>

      <View style={styles.cameraControls}>
        <TouchableOpacity style={styles.captureButton} onPress={capturePhoto}>
          <Ionicons name='camera' size={32} color='white' />
        </TouchableOpacity>
      </View>
    </View>
  );

  const renderInstructions = () => (
    <ScrollView style={styles.instructionsContainer}>
      <View style={styles.stepHeader}>
        <Ionicons
          name={captureSteps[currentStep].icon as any}
          size={48}
          color='#007AFF'
        />
        <Text style={styles.stepTitle}>{captureSteps[currentStep].title}</Text>
        <Text style={styles.stepDescription}>
          {captureSteps[currentStep].description}
        </Text>
      </View>

      <View style={styles.instructionsList}>
        <Text style={styles.instructionsTitle}>拍攝指引：</Text>
        {captureSteps[currentStep].instructions.map((instruction, index) => (
          <View key={index} style={styles.instructionItem}>
            <Text style={styles.instructionNumber}>{index + 1}</Text>
            <Text style={styles.instructionText}>{instruction}</Text>
          </View>
        ))}
      </View>

      <View style={styles.tipsContainer}>
        <Text style={styles.tipsTitle}>💡 拍攝技巧：</Text>
        <Text style={styles.tipText}>• 保持手機穩定，避免抖動</Text>
        <Text style={styles.tipText}>• 確保光線充足，避免陰影</Text>
        <Text style={styles.tipText}>• 保持適當距離，避免過近或過遠</Text>
        <Text style={styles.tipText}>• 對焦清晰，避免模糊</Text>
      </View>

      <View style={styles.progressContainer}>
        <Text style={styles.progressText}>
          步驟 {currentStep + 1} / {captureSteps.length}
        </Text>
        <View style={styles.progressBar}>
          <View
            style={[
              styles.progressFill,
              { width: `${((currentStep + 1) / captureSteps.length) * 100}%` },
            ]}
          />
        </View>
      </View>
    </ScrollView>
  );

  if (cameraPermission === null) {
    return (
      <View style={styles.permissionContainer}>
        <Ionicons name='camera' size={64} color='#007AFF' />
        <Text style={styles.permissionTitle}>需要相機權限</Text>
        <Text style={styles.permissionText}>
          為了進行 BGS 模擬鑑定，需要訪問您的相機
        </Text>
        <TouchableOpacity
          style={styles.permissionButton}
          onPress={requestCameraPermission}
        >
          <Text style={styles.permissionButtonText}>允許相機權限</Text>
        </TouchableOpacity>
      </View>
    );
  }

  if (cameraPermission === false) {
    return (
      <View style={styles.permissionContainer}>
        <Ionicons name='camera-off' size={64} color='#FF3B30' />
        <Text style={styles.permissionTitle}>相機權限被拒絕</Text>
        <Text style={styles.permissionText}>
          請在設置中允許相機權限以繼續使用
        </Text>
        <TouchableOpacity style={styles.cancelButton} onPress={onCancel}>
          <Text style={styles.cancelButtonText}>取消</Text>
        </TouchableOpacity>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <View style={styles.header}>
        <Text style={styles.headerTitle}>BGS 模擬鑑定</Text>
        <Text style={styles.headerSubtitle}>專業拍攝指引</Text>
      </View>

      {renderInstructions()}

      <View style={styles.actionButtons}>
        <TouchableOpacity
          style={styles.startCameraButton}
          onPress={() => setCurrentStep(currentStep + 1)}
        >
          <Text style={styles.startCameraButtonText}>開始拍攝</Text>
        </TouchableOpacity>

        <TouchableOpacity style={styles.cancelButton} onPress={onCancel}>
          <Text style={styles.cancelButtonText}>取消</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#f8f9fa',
  },
  header: {
    padding: 20,
    backgroundColor: 'white',
    borderBottomWidth: 1,
    borderBottomColor: '#e1e5e9',
  },
  headerTitle: {
    fontSize: 24,
    fontWeight: 'bold',
    color: '#1a1a1a',
    textAlign: 'center',
  },
  headerSubtitle: {
    fontSize: 16,
    color: '#6c757d',
    textAlign: 'center',
    marginTop: 4,
  },
  instructionsContainer: {
    flex: 1,
    padding: 20,
  },
  stepHeader: {
    alignItems: 'center',
    marginBottom: 30,
  },
  stepTitle: {
    fontSize: 20,
